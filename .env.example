YANDEX_API_KEY='ваш API-ключ Yandex Cloud'
YANDEX_FOLDER_ID='ваш folder_id из Yandex Cloud'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskmaster
# Настраиваемый бюджет запроса, а не декларация размера окна модели.
CONTEXT_BUDGET_TOKENS=16000
RESPONSE_RESERVE_TOKENS=2000
# Сжимать при достижении этой доли бюджета (ввод + резерв ответа).
CONTEXT_COMPRESSION_THRESHOLD=0.75
MAX_COMPRESSION_PARTS=32
# Пустой пароль: доступ только с localhost. Для внешнего доступа нужны пароль и HTTPS.
APP_USERNAME=owner
APP_PASSWORD=
# Включайте только для доверенной локальной сети/локального Docker.
APP_ALLOW_HTTP=false

# Полный цикл агента: ограничение времени, включая сжатие и повторные предложения (1–180 сек.).
MODEL_OPERATION_TIMEOUT_SECONDS=180
# Неудачные входы за минуту на один процесс сервера.
AUTH_ATTEMPTS_PER_MINUTE=10
AUTH_GLOBAL_ATTEMPTS_PER_MINUTE=100

# Максимальный объём тела HTTP-запроса (1 МиБ).
MAX_REQUEST_BYTES=1048576

# Срок сессии владельца, секунд (по умолчанию 12 часов).
AUTH_SESSION_SECONDS=43200
