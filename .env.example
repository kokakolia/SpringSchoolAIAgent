YANDEX_API_KEY='ваш API-ключ Yandex Cloud'
YANDEX_FOLDER_ID='ваш folder_id из Yandex Cloud'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskmaster
# Настраиваемый бюджет запроса, а не декларация размера окна модели.
CONTEXT_BUDGET_TOKENS=16000
RESPONSE_RESERVE_TOKENS=2000
# Сжимать при достижении этой доли бюджета (ввод + резерв ответа).
CONTEXT_COMPRESSION_THRESHOLD=0.75
